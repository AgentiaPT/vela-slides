            {
              "title": "Edge function handler",
              "duration": 120,
              "bg": "#071824",
              "bgGradient": "linear-gradient(160deg, #071824 0%, #0b2536 60%, #0e3247 100%)",
              "color": "#ecfeff",
              "accent": "#22d3ee",
              "padding": "40px 56px",
              "align": "left",
              "verticalAlign": "center",
              "blocks": [
                {
                  "type": "heading",
                  "text": "Edge function handler",
                  "size": "2xl",
                  "icon": "Code2",
                  "iconColor": "#22d3ee"
                },
                {
                  "type": "spacer",
                  "h": 1
                },
                {
                  "type": "code",
                  "label": "TYPESCRIPT",
                  "size": "md",
                  "bg": "rgba(2,12,20,0.6)",
                  "color": "#d5f3fa",
                  "text": "export default {\n  async fetch(req: Request, env: Env) {\n    const key = new URL(req.url).pathname;\n    const hit = await env.CACHE.get(key);\n    if (hit) return new Response(hit, { headers: { \"x-cache\": \"HIT\" } });\n    const body = await (await fetch(env.ORIGIN + key)).text();\n    await env.CACHE.put(key, body, { expirationTtl: 60 });\n    return new Response(body, { headers: { \"x-cache\": \"MISS\" } });\n  },\n};"
                },
                {
                  "type": "text",
                  "text": "One handler, deployed to 280+ locations. The origin only sees cache misses.",
                  "size": "md",
                  "color": "#a8d5e2"
                }
              ],
              "mutedColor": "#8fbccd"
            },
