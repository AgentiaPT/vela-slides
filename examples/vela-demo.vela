                {
                  "type": "heading",
                  "text": "Vela Slides",
                  "size": "4xl",
                  "align": "center"
                },
                {
                  "type": "spacer",
                  "h": 12
                },
                {
                  "type": "heading",
                  "text": "Agent-native presentations · Claude.ai · Browser · Desktop",
                  "size": "lg",
                  "align": "center",
                  "color": "#a5b4fc"
                },
                {
                  "type": "spacer",
                  "h": 32
                },
                {
                  "type": "text",
                  "text": "Think in slides. Let AI build them.\nEvery slide in this deck demonstrates the feature it describes.",
                  "size": "lg",
                  "align": "center",
                  "color": "#7c8aaf"
                },
                {
                  "type": "spacer",
                  "h": 24
                }
              ],
              "title": "Vela Slides",
              "bg": "#0f172a",
              "bgGradient": "linear-gradient(140deg, #0f172a 0%, #1e1b4b 40%, #312e81 70%, #1e3a5f 100%)",
              "color": "#f1f5f9",
              "accent": "#818cf8",
              "align": "center",
              "verticalAlign": "center",
              "padding": "48px 80px",
              "duration": 20
            },
            {
              "blocks": [
                {
                  "type": "heading",
                  "text": "You Think. Vela Shows.",
                  "size": "3xl",
                  "iconColor": "#3b82f6",
                  "icon": "Zap"
                },
                {
                  "type": "spacer",
                  "h": 12
                },
                {
                  "type": "text",
                  "text": "Vela is an agent-native presentation engine. Run it in a Claude.ai artifact, a local browser, or a native desktop window — and Vera, the built-in AI, turns your descriptions into structured slides. No design skills. No separate tools. Just intent to output.",
                  "size": "lg",
                  "color": "#94a3b8"
                },
                {
                  "type": "spacer",
                  "h": 24
                },
                {
                  "type": "flow",
                  "items": [
                    {
                      "icon": "Brain",
                      "label": "Your Idea"
                    },
                    {
                      "icon": "MessageSquare",
                      "label": "Describe"
                    },
                    {
                      "icon": "Cpu",
                      "label": "Vera Builds"
                    },
                    {
                      "icon": "Eye",
                      "label": "Review"
                    },
                    {
                      "icon": "Presentation",
                      "label": "Present"
                    }
                  ],
                  "labelColor": "#e2e8f0",
                  "arrowColor": "#3b82f6",
                  "iconBg": "#1e293b",
                  "connectorStyle": "arrow"
                },
                {
                  "type": "spacer",
                  "h": 24
                },
                {
                  "type": "callout",
                  "text": "Same engine, three runtimes — Claude.ai artifact, local browser server, or native desktop. Vera routes to whichever AI backend is available.",
                  "color": "#e2e8f0",
                  "bg": "#3b82f612",
                  "border": "#3b82f630",
                  "icon": "Shield"
                }
              ],
              "title": "What is Vela?",
              "bg": "#0f172a",
              "bgGradient": "linear-gradient(135deg, #0f172a 0%, #1e293b 100%)",
              "color": "#e2e8f0",
